DATABASE_URL=postgresql://ether_user:ether_password@localhost:5432/ether_db
# Set to 0 when DATABASE_URL points to Supabase's transaction pooler (port 6543)
DB_STATEMENT_CACHE_SIZE=
STORAGE_DIR=./storage
# Folder of a trained ml_engine bundle (artifacts/model-v<version>/). Empty: the app
# starts without a model, /health says model_loaded=false and classification answers 503.
MODEL_BUNDLE_PATH=
# Integration test only: a JPG/PNG to classify with the real bundle
# ML_SAMPLE_IMAGE=
# meta (default): real Muse Spark, answers 503 LLM_UNAVAILABLE without a key.
# fake: canned answers, only for local development.
LLM_PROVIDER=meta
# Spend cap (per process, resets on restart)
LLM_DAILY_TOKEN_BUDGET=1000000
LLM_MAX_REQUESTS_PER_MINUTE=30
META_MODEL_API_KEY=
META_MODEL_ID=muse-spark-1.3
# Upper bound on generated tokens per call, reasoning included (measured: a report
# at effort low used up to 1,659)
META_MODEL_MAX_COMPLETION_TOKENS=4096
# Reasoning effort of the report (structured JSON): minimal, low, medium, high, xhigh
# or max. low gave valid reports in about 15 s; muse-spark-1.3 rejects none
META_MODEL_REPORT_REASONING_EFFORT=low
# Reasoning effort of the chat (streamed). The stream sends nothing while the model
# reasons: about 3 s to the first word at minimal, about 8 s at low
META_MODEL_CHAT_REASONING_EFFORT=minimal
CORS_ORIGINS=http://localhost:3000,https://ether.vercel.app
